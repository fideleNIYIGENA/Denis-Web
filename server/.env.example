# ============================================================
#  Denis Ndayishimiye - Backend Environment Variables
#  Copy this file to ".env" and fill in real values.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- CORS (comma separated list of allowed frontend origins) ---
# Local: http://localhost:5173
# Vercel / Netlify: https://your-frontend-domain.vercel.app
CLIENT_URL=http://localhost:5173

# --- Supabase ---
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service Role Key (from Supabase Dashboard > Settings > API).
# WARNING: never expose this key to the browser. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- JWT ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Default Administrator (used only by the seed script) ---
# Change these in production AFTER seeding once, or keep them:
ADMIN_USERNAME=DenisAdmin@web
ADMIN_EMAIL=admin@denisweb.local
ADMIN_PASSWORD=DenisWeb@2026

# --- Site (used for email links / fallback meta) ---
SITE_URL=http://localhost:5173
SITE_NAME=Denis Ndayishimiye
