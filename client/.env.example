# Denis Ndayishimiye — Frontend Environment Variables
# Copy to ".env.local" for local development, or set in Vercel / Netlify.

# --- API ---
# Local backend: http://localhost:5000/api
# Production (Render/Railway): https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# --- Site ---
VITE_SITE_URL=http://localhost:5173
VITE_SITE_NAME=Denis Ndayishimiye

# --- Supabase (public keys only — safe to expose to the browser) ---
# From Supabase Dashboard → Settings → API:
#   Project URL        -> VITE_SUPABASE_URL
#   publishable/anon   -> VITE_SUPABASE_PUBLISHABLE_KEY
# Never put the service_role key in any VITE_ variable or frontend file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
